# Copia este archivo a .env y llena los valores:  cp .env.example .env
# Evita el carácter $ en los valores (Compose lo interpreta como variable).

# URL con la que se entra a Jenkins desde el navegador
JENKINS_URL=http://mi-servidor:18090/
# Puertos del servidor: libres en el servidor (8080/8081/9000/18081/19000 ya los usan otros servicios)
JENKINS_PORT=18090
SONAR_PORT=19090

JENKINS_ADMIN_PASSWORD=
# 12+ caracteres con mayúscula, minúscula, número y símbolo (política de SonarQube)
SONAR_ADMIN_PASSWORD=
SONAR_DB_PASSWORD=

# Repos que construye Jenkins (HTTPS, separados por coma; cada uno se vuelve un job con su nombre)
# y un usuario + token con permiso de lectura en todos
GIT_REPOS=https://github.com/mi-org/mobofacil.git,https://github.com/mi-org/otro-proyecto.git
GIT_USERNAME=
GIT_TOKEN=

# Usuario + token con permiso de push en el registry de imágenes (opcional: vacío mientras no haya registry)
REGISTRY_USERNAME=
REGISTRY_TOKEN=

# Usuario SSH de los workers de Kubernetes (credencial nodes-ssh; llave en secrets/nodes-ssh)
NODES_SSH_USER=madmin

# GID del grupo docker del servidor:  getent group docker | cut -d: -f3
DOCKER_GID=988
